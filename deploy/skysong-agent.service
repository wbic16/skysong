[Unit]
Description=Skysong camera agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=wbic16
SupplementaryGroups=video
ExecStart=/usr/bin/python3 /home/wbic16/skysong/agent/skysong-agent.py --port 8642
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
